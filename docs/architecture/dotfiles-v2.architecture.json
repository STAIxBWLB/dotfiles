  "cards": [
    {
      "dot": "cyan",
      "title": "Check and apply",
      "items": [
        "14 modules run in a fixed defaultOrder, filtered by the profile and --module",
        "Modules render embedded templates (internal/template) and write through exec.Runner",
        "exec.Runner logs instead of writing under --dry-run"
      ]
    },
    {
      "dot": "violet",
      "title": "AI tooling and admission",
      "items": [
        "dot ai tools and dot ai update reconcile only the selected agent CLIs and tools",
        "dot ai agents renders ~/.config/dotfiles/agents/AGENTS.md into each tool's instruction file",
        "The coauthor guard wires a commit-msg hook through git config-based hooks",
        "dot admit, dot ai run and tooling updates share one controller: a heavy slot per repo, one maintenance slot per host",
        "The gate defers (dot admit exits 75) on memory, thermal, WindowServer or CPU pressure"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sync and peer",
      "items": [
        "dot sync pushes with previewed rsync; intake is a separate pull; launchd or systemd units can schedule each",
        ".git and linked worktree roots are always excluded",
        "dot peer syncs with one SSH peer; an owner epoch fence demotes the losing coordinator",
        "handover and takeover move the coordinator role; dot peer git status and realign classify repos"
      ]
    },
    {
      "dot": "amber",
      "title": "Watchdog and secrets",
      "items": [
        "Opt-in reaper LaunchAgent: enforce mode sends SIGTERM, waits, then SIGKILL",
        "Optional WARP heal, monit and Beszel agents; alerts via macOS notification or ntfy",
        "dot secrets encrypts the SSH key, shell secrets and Beszel env with age",
        "dot profile snapshots config and app lists, optionally age identities"
      ]
    }
  ]
