[
  "\n",
  "  dot  \n",
  "  User environment & workspace management tool\n",
  "\n",
  "  dotfiles: Declarative user environment configuration with modular profiles.\n",
  "\n",
  "  Run without arguments to see a getting-started guide. Run 'dot usecase' for\n",
  "  detailed workflow examples. Also available as 'dotfiles' for back-compat.\n",
  "\n",
  "> Usage\n",
  "  dot [flags]\n",
  "\n",
  "> Setup\n",
  "  apply        Apply dot configuration\n",
  "  config       Show current configuration\n",
  "  diff         Show pending changes without applying\n",
  "  init         Interactive setup for dot\n",
  "  reconfigure  Re-run init prompts with current values as defaults\n",
  "  rollback     Activate the previous standalone dot binary\n",
  "  status       Show full environment status at a glance\n",
  "  update       Update dot binary to the latest or a selected version\n",
  "  version      Print version information\n",
  "\n",
  "> Workspace\n",
  "  clean       Remove junk directories from the workspace\n",
  "  hub         Open a project's agent-hub console or window\n",
  "  layouts     List available workspace layouts\n",
  "  list        List registered projects and active tmux sessions\n",
  "  noindex     Keep Spotlight out of build and cache directories\n",
  "  open        Launch or resume a tmux workspace\n",
  "  register    Register a project for workspace management\n",
  "  stop        Stop a tmux workspace session\n",
  "  unregister  Remove a registered project\n",
  "  ws          Dual-workspace (work + cloud mirror) folder operations\n",
  "\n",
  "> Sync\n",
  "  peer    Sync the workspace directly to another machine over SSH\n",
  "  remote  Run builds and tests in a container on an ssh-reachable host\n",
  "  sync    Sync workspace to a local mirror or SSH remote via rsync\n",
  "\n",
  "> AI\n",
  "  ai     AI CLI/config helpers and settings backup/restore\n",
  "  guard  Manage Claude Code safety hooks\n",
  "\n",
  "> Backup and secrets\n",
  "  apps     Install macOS apps and back up their settings\n",
  "  backup   One-stop interactive backup (profile, apps, AI, secrets)\n",
  "  profile  Snapshot and restore dot profile state\n",
  "  restore  One-stop interactive restore (profile, apps, AI, secrets)\n",
  "  secrets  Manage encrypted secrets\n",
  "\n",
  "> Host\n",
  "  admit      Run one heavy job per repo behind the host-pressure gate\n",
  "  container  Run the shared container backend\n",
  "  tunnel     Manage Cloudflare Tunnel SSH access for this Mac\n",
  "  watchdog   Reap runaway processes and alert on host health\n",
  "\n",
  "> Help\n",
  "  completion  Generate a shell completion script\n",
  "  help        Show help for a command\n",
  "  usecase     Show detailed use cases and workflows\n",
  "\n",
  "> Flags\n",
  "  -h, --help     help for dot\n",
  "  -v, --version  version for dot\n",
  "\n",
  "> Global flags\n",
  "  --ascii          use ASCII markers regardless of locale\n",
  "  --color string   color output: auto, always or never (default \"auto\")\n",
  "  --config string  path to custom config YAML\n",
  "  --dry-run        show what would be done without executing\n",
  "  --home string    override home directory (for admin setup of other users)\n",
  "  --verbose        show library and debug logs on stderr\n",
  "  --yes            unattended mode (skip all prompts)\n",
  "\n",
  "> Examples\n",
  "  dot\n",
  "  dot usecase\n",
  "\n",
  "> Aliases\n",
  "  dotfiles\n",
  ""
]
