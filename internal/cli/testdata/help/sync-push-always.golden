[
  "\n",
  " \u001b[1;34m dot sync push \u001b[m \n",
  "  \u001b[90mPreview and send workspace changes to the mirror\u001b[m\n",
  "\n",
  "  Push the workspace tree to the sync target (local: or ssh:) under a\n",
  "  propagation policy. The default policy '{create:true, update:true,\n",
  "  delete:false}' copies new and modified files but never deletes mirror-side\n",
  "  content. By default push prints the upload plan and asks before applying.\n",
  "\n",
  "  Flag --propagate= takes a comma-separated allowlist; absent items are\n",
  "  disabled.\n",
  "\n",
  "  The per-workspace store (.dotfiles/) and intake staging area (inbox/gdrive/)\n",
  "  are always excluded so they never round-trip to mirror.\n",
  "\n",
  "  Backups under the mirror's .sync-conflicts/ keep only what can be lost:\n",
  "  propagated deletions and overwrites of a copy changed in the mirror. A routine\n",
  "  update leaves none. A mirror copy with the same bytes and only a new mtime is\n",
  "  not a conflict.\n",
  "\n",
  "  Previews, including --dry-run, display operator-approved sensitive overrides.\n",
  "  Dry-run does not transfer files.\n",
  "\n",
  "\u001b[1;35m▸ Usage\u001b[m\n",
  "  dot sync push [flags]\n",
  "\n",
  "\u001b[1;35m▸ Flags\u001b[m\n",
  "  \u001b[34m--filter-mode string\u001b[m  override config filter mode for this run: include or\n",
  "                        exclude\n",
  "  \u001b[34m-h, --help\u001b[m            help for push\n",
  "  \u001b[34m--mode string\u001b[m         execution mode for push/pull: manual, clean, or force\n",
  "                        (default \"manual\")\n",
  "  \u001b[34m--propagate string\u001b[m    comma-separated allowlist of propagation kinds\n",
  "                        (create,update,delete)\n",
  "\n",
  "\u001b[1;35m▸ Global flags\u001b[m\n",
  "  \u001b[34m--ascii\u001b[m          use ASCII markers regardless of locale\n",
  "  \u001b[34m--color string\u001b[m   color output: auto, always or never (default \"auto\")\n",
  "  \u001b[34m--config string\u001b[m  path to custom config YAML\n",
  "  \u001b[34m--dry-run\u001b[m        show what would be done without executing\n",
  "  \u001b[34m--home string\u001b[m    override home directory (for admin setup of other users)\n",
  "  \u001b[34m--store string\u001b[m   sync store under <workspace>/.dotfiles/<store>/; \"sync\" is\n",
  "                   the cloud mirror, \"peer\" the other Mac (default \"sync\")\n",
  "  \u001b[34m-V, --verbose\u001b[m    show rsync progress output\n",
  "  \u001b[34m--yes\u001b[m            unattended mode (skip all prompts)\n",
  "\n",
  "\u001b[1;35m▸ Examples\u001b[m\n",
  "  dot sync push\n",
  "  dot sync push --propagate=create,update,delete\n",
  ""
]
