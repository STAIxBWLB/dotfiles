[
  "\n",
  " \u001b[1;34m dot \u001b[m \n",
  "  \u001b[90mUser environment & workspace management tool\u001b[m\n",
  "\n",
  "  dotfiles: Declarative user environment configuration with modular profiles.\n",
  "\n",
  "  Run without arguments to see a getting-started guide. Run 'dot usecase' for\n",
  "  detailed workflow examples. Also available as 'dotfiles' for back-compat.\n",
  "\n",
  "\u001b[1;35m▸ Usage\u001b[m\n",
  "  dot [flags]\n",
  "\n",
  "\u001b[1;35m▸ Setup\u001b[m\n",
  "  \u001b[34mapply\u001b[m        Apply dot configuration\n",
  "  \u001b[34mconfig\u001b[m       Show current configuration\n",
  "  \u001b[34mdiff\u001b[m         Show pending changes without applying\n",
  "  \u001b[34minit\u001b[m         Interactive setup for dot\n",
  "  \u001b[34mreconfigure\u001b[m  Re-run init prompts with current values as defaults\n",
  "  \u001b[34mrollback\u001b[m     Activate the previous standalone dot binary\n",
  "  \u001b[34mstatus\u001b[m       Show full environment status at a glance\n",
  "  \u001b[34mupdate\u001b[m       Update dot binary to the latest or a selected version\n",
  "  \u001b[34mversion\u001b[m      Print version information\n",
  "\n",
  "\u001b[1;35m▸ Workspace\u001b[m\n",
  "  \u001b[34mclean\u001b[m       Remove junk directories from the workspace\n",
  "  \u001b[34mhub\u001b[m         Open a project's agent-hub console or window\n",
  "  \u001b[34mlayouts\u001b[m     List available workspace layouts\n",
  "  \u001b[34mlist\u001b[m        List registered projects and active tmux sessions\n",
  "  \u001b[34mnoindex\u001b[m     Keep Spotlight out of build and cache directories\n",
  "  \u001b[34mopen\u001b[m        Launch or resume a tmux workspace\n",
  "  \u001b[34mregister\u001b[m    Register a project for workspace management\n",
  "  \u001b[34mstop\u001b[m        Stop a tmux workspace session\n",
  "  \u001b[34munregister\u001b[m  Remove a registered project\n",
  "  \u001b[34mws\u001b[m          Dual-workspace (work + cloud mirror) folder operations\n",
  "\n",
  "\u001b[1;35m▸ Sync\u001b[m\n",
  "  \u001b[34mpeer\u001b[m    Sync the workspace directly to another machine over SSH\n",
  "  \u001b[34mremote\u001b[m  Run builds and tests in a container on an ssh-reachable host\n",
  "  \u001b[34msync\u001b[m    Sync workspace to a local mirror or SSH remote via rsync\n",
  "\n",
  "\u001b[1;35m▸ AI\u001b[m\n",
  "  \u001b[34mai\u001b[m     AI CLI/config helpers and settings backup/restore\n",
  "  \u001b[34mguard\u001b[m  Manage Claude Code safety hooks\n",
  "\n",
  "\u001b[1;35m▸ Backup and secrets\u001b[m\n",
  "  \u001b[34mapps\u001b[m     Install macOS apps and back up their settings\n",
  "  \u001b[34mbackup\u001b[m   One-stop interactive backup (profile, apps, AI, secrets)\n",
  "  \u001b[34mprofile\u001b[m  Snapshot and restore dot profile state\n",
  "  \u001b[34mrestore\u001b[m  One-stop interactive restore (profile, apps, AI, secrets)\n",
  "  \u001b[34msecrets\u001b[m  Manage encrypted secrets\n",
  "\n",
  "\u001b[1;35m▸ Host\u001b[m\n",
  "  \u001b[34madmit\u001b[m      Run one heavy job per repo behind the host-pressure gate\n",
  "  \u001b[34mcontainer\u001b[m  Run the shared container backend\n",
  "  \u001b[34mgit\u001b[m        Git settings dot manages beyond the config file\n",
  "  \u001b[34mtunnel\u001b[m     Manage Cloudflare Tunnel SSH access for this Mac\n",
  "  \u001b[34mwatchdog\u001b[m   Reap runaway processes and alert on host health\n",
  "\n",
  "\u001b[1;35m▸ Help\u001b[m\n",
  "  \u001b[34mcompletion\u001b[m  Generate a shell completion script\n",
  "  \u001b[34mhelp\u001b[m        Show help for a command\n",
  "  \u001b[34musecase\u001b[m     Show detailed use cases and workflows\n",
  "\n",
  "\u001b[1;35m▸ Flags\u001b[m\n",
  "  \u001b[34m-h, --help[=true|false]\u001b[m     help for dot\n",
  "  \u001b[34m-v, --version[=true|false]\u001b[m  version for dot\n",
  "\n",
  "\u001b[1;35m▸ Global flags\u001b[m\n",
  "  \u001b[34m--ascii[=true|false]\u001b[m    use ASCII markers regardless of locale\n",
  "  \u001b[34m--color string\u001b[m          color output: auto, always or never (default \"auto\")\n",
  "  \u001b[34m--config string\u001b[m         path to custom config YAML\n",
  "  \u001b[34m--dry-run[=true|false]\u001b[m  show what would be done without executing\n",
  "  \u001b[34m--home string\u001b[m           override home directory (for admin setup of other\n",
  "                          users)\n",
  "  \u001b[34m--verbose[=true|false]\u001b[m  show library and debug logs on stderr\n",
  "  \u001b[34m--yes[=true|false]\u001b[m      unattended mode (skip all prompts)\n",
  "\n",
  "\u001b[1;35m▸ Examples\u001b[m\n",
  "  dot\n",
  "  dot usecase\n",
  "\n",
  "\u001b[1;35m▸ Aliases\u001b[m\n",
  "  dotfiles\n",
  ""
]
