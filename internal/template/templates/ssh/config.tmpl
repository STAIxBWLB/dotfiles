# 사용자 커스텀 (git 미추적). Host 블록보다 앞에 둬야 모든 호스트에 적용된다.
Include ~/.ssh/config.d/*

Host *
    IdentityFile ~/.ssh/{{ .SSHKeyName }}
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{ if .IsDarwin }}
    IgnoreUnknown UseKeychain,AddKeysToAgent
    UseKeychain yes
    AddKeysToAgent yes
{{ end }}

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{ .SSHKeyName }}
